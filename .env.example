# ===== BANCO DE DADOS =====
DATABASE_URL=jdbc:postgresql://localhost:5432/moeda
DATABASE_USER=moeda
DATABASE_PASSWORD=moeda

# ===== RABBITMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=moeda
RABBITMQ_PASSWORD=moeda
NOTIFICATIONS_RABBIT_ENABLED=true
NOTIFICATIONS_RABBIT_EXCHANGE=moeda.notifications
NOTIFICATIONS_RABBIT_QUEUE=moeda.notifications.email
NOTIFICATIONS_RABBIT_ROUTING_KEY=email

# ===== EMAILJS - Obter chaves em https://dashboard.emailjs.com =====
EMAILJS_ENABLED=true
EMAILJS_SERVICE_ID=service_xxxxxxxxx
EMAILJS_PUBLIC_KEY=seu_public_key_aqui
EMAILJS_PRIVATE_KEY=seu_private_key_aqui

# Templates para emails de ENVIO DE MOEDAS (obrigatórios)
# Crie templates com as variáveis: {{to_email}}, {{to_name}}, {{subject}}, {{message}}, {{professor_nome}}, {{aluno_nome}}, {{quantidade}}, {{justificativa}}
EMAILJS_TEMPLATE_ALUNO_ID=template_para_aluno_recebendo_moedas
EMAILJS_TEMPLATE_PROFESSOR_ID=template_para_professor_enviando_moedas

# Templates para emails de RESGATE (opcionais)
EMAILJS_TEMPLATE_RESGATE_ALUNO_ID=template_para_aluno_resgate
EMAILJS_TEMPLATE_RESGATE_PARCEIRO_ID=template_para_parceiro_resgate

# ===== WHATSAPP BUSINESS API (Meta) - SEM CUSTO =====
WHATSAPP_ENABLED=true
META_ACCESS_
META_BUSINESS_ACCOUNT_ID=1651409009498647
META_PHONE_NUMBER_ID=1134451516419869
META_PHONE_NUMBER=+5531995171882

# ===== ZAPSENDER (opcional) =====
ZAPSENDER_ENABLED=false
ZAPSENDER_API_URL=
ZAPSENDER_TOKEN=

# ===== APLICAÇÃO =====
PORT=8080
JWT_SECRET=sua_chave_jwt_256_bits_ou_maior
JWT_EXPIRATION_MIN=1440
API_BASE_URL=http://localhost:8080
