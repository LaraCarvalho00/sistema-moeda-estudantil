DATABASE_URL=jdbc:postgresql://localhost:5432/moeda
# Em Docker Compose, use o host do serviço Postgres, ex.: jdbc:postgresql://db:5432/moeda
DATABASE_USER=moeda
DATABASE_PASSWORD=moeda
JWT_SECRET=troque-para-uma-chave-aleatoria-longa-256-bits
JWT_EXPIRATION_MIN=1440
MAIL_ENABLED=false
API_BASE_URL=http://localhost:8080
PORT=8080

# RabbitMQ para fila de notificacoes
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=moeda
RABBITMQ_PASSWORD=moeda
NOTIFICATIONS_RABBIT_ENABLED=true
NOTIFICATIONS_RABBIT_EXCHANGE=moeda.notifications
NOTIFICATIONS_RABBIT_QUEUE=moeda.notifications.email
NOTIFICATIONS_RABBIT_ROUTING_KEY=email

# EmailJS
EMAILJS_ENABLED=false
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ZapSender / provedor WhatsApp compativel com payload { phone, text }
ZAPSENDER_ENABLED=false
ZAPSENDER_API_URL=
ZAPSENDER_TOKEN=
