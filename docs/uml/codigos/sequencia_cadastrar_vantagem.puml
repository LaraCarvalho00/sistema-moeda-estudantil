@startuml
!theme plain
autonumber

actor "Empresa Parceira" as Parceiro
boundary "ParceiroVantagensPage" as SPA
participant "VantCri\n<<objeto requerido>>" as REQ
control "ControleVantagensResgate" as REST
participant "VantagemPort" as PORT
participant "VantagemAdapter" as ADAPTER
database "PostgreSQL\nvantagens" as DB

Parceiro -> SPA : informa titulo, descricao e custo
SPA -> REQ : monta payload
SPA -> REST : POST /api/v1/parceiro/vantagens
REST -> REST : @PreAuthorize + @Valid
REST -> PORT : salvar(parceiroId, ...)
PORT -> ADAPTER : implementacao
ADAPTER -> DB : INSERT vantagem
DB --> ADAPTER : vantagem persistida
ADAPTER --> REST : Vantagem
REST --> SPA : 201 Created
SPA --> Parceiro : atualiza lista de ofertas

alt contrato ou perfil invalido
  REST --> SPA : 400/403/422
  SPA --> Parceiro : exibe erro
end
@enduml
