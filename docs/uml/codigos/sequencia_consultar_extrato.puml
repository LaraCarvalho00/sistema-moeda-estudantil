@startuml
!theme plain
autonumber

actor "Aluno ou Professor" as Usuario
boundary "ExtratoPage" as SPA
control "ControleMoedasERelatorio" as REST
control "TransacaoFachada" as APP
participant "TransacaoPort" as PORT
participant "TransacaoAdapter" as ADAPTER
database "PostgreSQL\ntransacoes" as DB

Usuario -> SPA : abre extrato
SPA -> REST : GET /api/v1/transacoes/extrato?page=...
REST -> REST : identifica perfil do JWT
alt professor
  REST -> APP : extratoProfessor(usuarioId, page)
else aluno
  REST -> APP : extratoAluno(usuarioId, page)
end
APP -> PORT : listar extrato paginado
PORT -> ADAPTER : implementacao
ADAPTER -> DB : SELECT transacoes do usuario
DB --> ADAPTER : pagina de transacoes
ADAPTER --> SPA : Page<TransacaoResumo>
SPA --> Usuario : exibe historico ou estado vazio
@enduml
