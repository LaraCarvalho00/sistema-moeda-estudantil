@startuml
!theme plain
autonumber

actor Aluno
boundary "MarketplacePage" as SPA
control "ControleVantagensResgate" as REST
participant "VantagemPort" as PORT
participant "VantagemAdapter" as ADAPTER
database "PostgreSQL\nvantagens + usuarios" as DB

Aluno -> SPA : abre marketplace
SPA -> REST : GET /api/v1/vantagens?page=...
REST -> PORT : listarTodas(pageable)
PORT -> ADAPTER : implementacao
ADAPTER -> DB : SELECT vantagens e parceiro
DB --> ADAPTER : pagina de vantagens
ADAPTER --> REST : Page<Vantagem>
REST --> SPA : 200 OK
SPA --> Aluno : exibe catalogo ou estado vazio
@enduml
